{
  "rewrites": [
    { "source": "/l/:id", "destination": "https://popup-api-hwbg.onrender.com/l/:id" },
    { "source": "/u/:username", "destination": "https://popup-api-hwbg.onrender.com/u/:username" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
