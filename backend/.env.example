# Server
PORT=5001
NODE_ENV=development

# Legacy Prisma/MySQL (optional if you still use it)
DATABASE_URL="mysql://root@localhost:3306/thriftapp"

# JWT (legacy Express auth only)
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Supabase (required for payments)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public URL of this backend.
# Production (TestFlight / App Store): the hosted HTTPS origin, no trailing slash.
# iOS Release must match: API_BASE_URL_RELEASE = https:/$()/<host>/api
# Stripe onboarding return links and the webhook URL use this host.
PUBLIC_BASE_URL=http://localhost:5001

# Frontend (optional)
FRONTEND_URL=http://localhost:3000

# Campus confirmation email (UO/OSU often drop Supabase's built-in mailer).
# https://resend.com — send from a domain you verified.
RESEND_API_KEY=
RESEND_FROM=popup <noreply@yourdomain.com>

# Payout two-factor: how recently (seconds) an authenticator code must have been
# entered before starting Stripe payout setup, opening the payout dashboard, or cashing out.
# Keep in sync with PayoutMFA.freshWindow in the iOS app.
PAYOUT_MFA_MAX_AGE_SECONDS=600

# GPT-6 Luna clothing identifier (Sell tab scan)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
IDENTIFY_RATE_LIMIT_PER_HOUR=12

# Stripe Connect (buyer Apple Pay/card checkout + seller payouts)
# Keys: https://dashboard.stripe.com/test/apikeys (use sk_test_/pk_test_ until launch).
# Turn on Connect (Express) at https://dashboard.stripe.com/test/connect/accounts/overview.
# The publishable key is sent to the app with each checkout, so iOS needs no Stripe key.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local: ./scripts/stripe-webhook-local.sh writes this for you.
# Hosted: Stripe Dashboard -> Developers -> Webhooks -> add
#   <PUBLIC_BASE_URL>/api/payments/webhook
# with events payment_intent.succeeded, payment_intent.payment_failed, transfer.reversed,
# charge.refunded, charge.dispute.created, then paste the signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_...

# Service fee the buyer pays on top of the listing price; popup keeps it and the
# seller gets the full price. Fee = max(PLATFORM_FEE_MIN_CENTS, round(price * PERCENT / 100) + FIXED_CENTS).
PLATFORM_FEE_PERCENT=10
PLATFORM_FEE_FIXED_CENTS=0
PLATFORM_FEE_MIN_CENTS=50

# Demo signup that skips email confirmation (local/dev only; ignored when NODE_ENV=production).
# DEMO_BYPASS_ENABLED=true
# DEMO_BYPASS_EMAIL=demo@popupdev.test
