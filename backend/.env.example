# Server
PORT=5001
NODE_ENV=development

# Legacy Prisma/MySQL (optional if you still use it)
DATABASE_URL="mysql://root@localhost:3306/thriftapp"

# JWT (legacy Express auth only)
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Supabase (required for payments)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public URL of this backend.
# Production (TestFlight / App Store): the hosted HTTPS origin, no trailing slash.
# iOS Release must match: API_BASE_URL_RELEASE = https:/$()/<host>/api
# Square OAuth redirect + webhook URLs below must use this host too (register both in Square).
PUBLIC_BASE_URL=http://localhost:5001

# Frontend (optional)
FRONTEND_URL=http://localhost:3000

# GPT-6 Luna clothing identifier (Sell tab scan)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
IDENTIFY_RATE_LIMIT_PER_HOUR=12

# SMS two-factor (Twilio). Required to cash out once 2FA is enabled in the app.
# Trial accounts cannot send custom SMS bodies — Popup uses Twilio Verify.
# Optional: paste a VA… SID from Identity → Verify if auto-create is blocked.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Square (all payments: Tap to Pay + buyer checkout)
# Create apps at https://developer.squareup.com/apps (sandbox + production).
# SQUARE_ACCESS_TOKEN + SQUARE_LOCATION_ID are Popup's merchant account that HOLDS funds.
# Seller OAuth is only for cash out. Redirect URI must match SQUARE_OAUTH_REDIRECT_URI.
SQUARE_APPLICATION_ID=sandbox-sq0idb-...
SQUARE_APPLICATION_SECRET=sandbox-sq0csp-...
SQUARE_ACCESS_TOKEN=EAAAl...
SQUARE_LOCATION_ID=L...
SQUARE_ENVIRONMENT=sandbox
SQUARE_OAUTH_REDIRECT_URI=http://localhost:5001/api/payments/square/oauth/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:5001/api/payments/square/webhook
