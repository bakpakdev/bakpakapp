<plist version="1.0">
<dict>
	<!-- Default Release entitlements: none, so Archive/TestFlight works before Apple
	     approves payment capabilities. Switch POPUP_RELEASE_ENTITLEMENTS in
	     Config/SupabaseProject.xcconfig to PopupApp.ApplePay.entitlements or
	     PopupApp.Payments.entitlements once the capabilities exist on the App ID. -->
</dict>
</plist>
